# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the site (used in emails and Stripe redirects)
NEXT_PUBLIC_SITE_URL=https://verimance.com

# Guardian AI (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
GUARDIAN_MODEL_FAST=claude-haiku-5-5
GUARDIAN_MODEL_SMART=claude-sonnet-5-5

# Guardian+ payments (dashboard.stripe.com). Leave empty to hide checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Emails: investor form, family ally alerts (resend.com). Optional.
RESEND_API_KEY=
EMAIL_FROM=Verimance <hello@verimance.com>
INVESTORS_INBOX=investors@verimance.com

# App store links (leave empty to show "Coming soon")
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
